# ─── Database (Supabase PostgreSQL) ───
# Get this from Supabase → Project Settings → Database → Connection string → URI
# Format: postgresql://postgres.[project]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─── Encryption secret ───
# Used to encrypt Medefis credentials + session tokens at rest (AES-256-GCM).
# Generate one with: openssl rand -base64 32
PARENT_SYSTEM_SECRET=

# ─── Headless browser service URL (optional) ───
# Only needed if you deploy the medefis-browser mini-service for automated login.
# If unset, the "Log in to Medefis automatically" button is disabled and admins
# use the manual cookie/token paste instead.
# Example: https://your-browser-service.railway.app
MEDEFIS_BROWSER_URL=
